# Environment variable reference.
#
# Every value below is provisioned through the Vercel Marketplace and pulled
# into .env.local with `vercel env pull`. This file documents the NAMES the
# application expects and must never contain real values.
#
# New machine:  vercel link  &&  vercel env pull

# --- Neon Postgres ------------------------------------------------------
# DATABASE_URL is pooled (PgBouncer) and is what the app uses at runtime.
# DATABASE_URL_UNPOOLED bypasses the pooler and is required for migrations,
# which need a session-level connection that a transaction pooler cannot give.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Clerk authentication -----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Stripe payments (sandbox) ------------------------------------------
# The sandbox resource can be converted to a live account later with
# `vercel integration resource claim website-builder-payments`.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Set once the webhook endpoint exists; not provisioned automatically.
STRIPE_WEBHOOK_SECRET=

# --- Sentry error tracking ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only: used to upload source maps. Never exposed to the client.
SENTRY_AUTH_TOKEN=

# --- Vercel Blob (private store for customer brand assets) --------------
BLOB_READ_WRITE_TOKEN=
