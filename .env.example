# Environment variable reference.
#
# Every value below is provisioned through the Vercel Marketplace and pulled
# into .env.local with `vercel env pull`. This file documents the NAMES the
# application expects and must never contain real values.
#
# New machine:  vercel link  &&  vercel env pull

# --- Application --------------------------------------------------------
# Minimum log level written: debug | info | warn | error.
# Defaults to debug in development, info in production, error under test.
LOG_LEVEL=

# --- Neon Postgres ------------------------------------------------------
# DATABASE_URL is pooled (PgBouncer) and is what the app uses at runtime.
# DATABASE_URL_UNPOOLED bypasses the pooler and is required for migrations,
# which need a session-level connection that a transaction pooler cannot give.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Clerk authentication -----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for POST /api/webhooks/clerk, taken from the endpoint you
# create in the Clerk dashboard (Configure -> Webhooks). Not provisioned by
# the integration. Without it the route returns 503 rather than trusting an
# unverified payload, so user rows can only be created by a signed-in visit.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Stripe payments (sandbox) ------------------------------------------
# The sandbox resource can be converted to a live account later with
# `vercel integration resource claim website-builder-payments`.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret for POST /api/webhooks/stripe, from the endpoint you create
# in the Stripe dashboard (or from `stripe listen` when testing locally). Not
# provisioned automatically. Without it the webhook returns 401 rather than
# trusting an unverified payload.
STRIPE_WEBHOOK_SECRET=

# --- Application URLs ----------------------------------------------------
# Absolute public origin, used to build the checkout return URLs. Falls back
# to the request's own origin, which is correct everywhere except behind a
# proxy that rewrites Host.
NEXT_PUBLIC_SITE_ORIGIN=

# --- Sentry error tracking ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only: used to upload source maps. Never exposed to the client.
SENTRY_AUTH_TOKEN=

# --- Vercel Blob (private store for customer brand assets) --------------
BLOB_READ_WRITE_TOKEN=
